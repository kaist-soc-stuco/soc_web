# Copy this file to .env on the production host, then replace every placeholder.
# Run: node infra/scripts/verify-production-env.mjs --env-file .env
NODE_ENV=production
API_PORT=3000
NGINX_PORT=8080

PUBLIC_ORIGIN=https://your-production-domain.example

# Compose-internal database and Redis addresses.
# Keep the password raw in POSTGRES_PASSWORD but URL-encode reserved characters in DATABASE_URL.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=soc_web
POSTGRES_USER=soc_prod
POSTGRES_PASSWORD=<generate-a-long-random-password>
DATABASE_URL=postgresql://soc_prod:<generate-a-long-random-password>@postgres:5432/soc_web?sslmode=disable
REDIS_HOST=redis
REDIS_PORT=6379

AUTH_JWT_ACTIVE_KID=prod-2026-rotate-01
AUTH_JWT_ES256_PRIVATE_KEY="<issued-pkcs8-p256-private-key>"
AUTH_JWT_PUBLIC_KEYS_JSON={"prod-2026-rotate-01":"<issued-spki-p256-public-key>"}
AUTH_JWT_ISSUER=soc-web-production
AUTH_JWT_AUDIENCE=soc-api
AUTH_PENDING_LOGIN_ENCRYPTION_KEY=<generate-a-32-byte-base64-key>

PII_ENCRYPTION_ACTIVE_KID=prod-pii-2026-01
PII_ENCRYPTION_KEYS_JSON={"prod-pii-2026-01":"<generate-a-32-byte-base64-key>"}
SURVEY_PHONE_HASH_HMAC_KEY=<generate-a-32-byte-base64-key>
SURVEY_PHONE_HASH_HMAC_VERSION=prod-survey-phone-v1
SURVEY_PHONE_HASH_HMAC_PRIOR_KEYS_JSON={}

VITE_SSO_REDIRECT_URI=https://your-production-domain.example/api/auth/login
VITE_SSO_LOGIN_URL=https://sso.kaist.ac.kr/auth/user/single/login/authorize
VITE_SSO_CLIENT_ID=<issued-passni-client-id>
SSO_AUTH_API_URL=https://sso.kaist.ac.kr/auth/api/single/auth
SSO_CLIENT_SECRET=<issued-passni-client-secret>

# Leave disabled except during the one-time, audited administrator bootstrap.
AUTHORIZATION_BOOTSTRAP_SSO_SUBJECT=
AUTHORIZATION_OPERATIONS_ENABLED=false

API_LOG_MAX_SIZE=20m
API_LOG_MAX_FILES=10
SURVEY_RESPONSE_PURGE_ENABLED=false
SURVEY_RESPONSE_PURGE_CADENCE_SECONDS=900
SURVEY_RESPONSE_PURGE_BATCH_SIZE=100
SURVEY_RESPONSE_PURGE_ALERT_OWNER=
SURVEY_RESPONSE_PURGE_ALERT_SINK=
SURVEY_IMAGE_CLEANUP_ENABLED=false
SURVEY_IMAGE_CLEANUP_CADENCE_SECONDS=900
SURVEY_IMAGE_CLEANUP_BATCH_SIZE=25
SURVEY_IMAGE_CLEANUP_GRACE_MS=3600000
SURVEY_IMAGE_CLEANUP_ALERT_OWNER=
SURVEY_IMAGE_CLEANUP_ALERT_SINK=

CONTENT_PURGE_GRACE_DAYS=30
CONTACT_PURGE_GRACE_DAYS=30
