FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY shared/contracts/package.json shared/contracts/package.json
COPY shared/common/package.json shared/common/package.json
COPY shared/config/package.json shared/config/package.json
COPY shared/config/tsconfig/base.json shared/config/tsconfig/base.json

RUN pnpm install --filter @soc/api... --frozen-lockfile

COPY apps/api apps/api
COPY shared/contracts shared/contracts
COPY shared/common shared/common
COPY shared/config shared/config

RUN pnpm --filter @soc/shared build
RUN pnpm --filter @soc/contracts build
RUN pnpm --filter @soc/api build

# The one-shot migration container needs the source schema and drizzle-kit,
# while the serving image below only carries compiled application code and
# production dependencies.
FROM build AS migration

RUN addgroup -S nodeapp \
  && adduser -S -G nodeapp nodeapp \
  && chown -R nodeapp:nodeapp /app

USER nodeapp

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=production

RUN addgroup -S nodeapp \
  && adduser -S -G nodeapp nodeapp \
  && corepack enable

COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/shared/contracts/package.json shared/contracts/package.json
COPY --from=build /app/shared/common/package.json shared/common/package.json

RUN pnpm install --filter @soc/api... --prod --frozen-lockfile \
  && mkdir -p /app/apps/api/uploads/assets /tmp \
  && chown -R nodeapp:nodeapp /app /tmp

COPY --from=build --chown=nodeapp:nodeapp /app/apps/api/dist apps/api/dist
COPY --from=build --chown=nodeapp:nodeapp /app/shared/contracts/dist shared/contracts/dist
COPY --from=build --chown=nodeapp:nodeapp /app/shared/common/dist shared/common/dist

WORKDIR /app/apps/api
USER nodeapp

EXPOSE 3000

CMD ["node", "dist/apps/api/src/main.js"]
