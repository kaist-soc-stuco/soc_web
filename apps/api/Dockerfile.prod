FROM node:22-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY shared/contracts/package.json shared/contracts/package.json
COPY shared/common/package.json shared/common/package.json
COPY shared/config/package.json shared/config/package.json
COPY shared/config/tsconfig/base.json shared/config/tsconfig/base.json

RUN pnpm install --filter @soc/api... --frozen-lockfile

COPY apps/api apps/api
COPY shared/contracts shared/contracts
COPY shared/common shared/common
COPY shared/config shared/config

RUN pnpm --filter @soc/shared build
RUN pnpm --filter @soc/contracts build
RUN pnpm --filter @soc/api build

FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=production

RUN corepack enable

COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/apps/api apps/api
COPY --from=build /app/shared/contracts shared/contracts
COPY --from=build /app/shared/common shared/common
COPY --from=build /app/shared/config shared/config

WORKDIR /app/apps/api

EXPOSE 3000

CMD ["pnpm", "start"]
