{
  "name": "@soc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @soc/shared build && ts-node-dev --respawn --transpile-only src/main.ts",
    "content:purge": "ts-node --transpile-only src/commands/content-purge.ts",
    "survey:purge": "ts-node --transpile-only src/commands/survey-response-purge.ts",
    "contact:purge": "ts-node --transpile-only src/commands/contact-purge.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:http": "vitest run --config vitest.config.ts --project http",
    "test:int": "vitest run --config vitest.config.ts --project integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@soc/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "drizzle-orm": "0.44.7",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.8",
    "@soc/contracts": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.5",
    "express": "^5.2.1",
    "supertest": "^7.1.4",
    "testcontainers": "^11.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
