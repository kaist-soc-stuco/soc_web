{
  "name": "@soc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:seed": "ts-node --transpile-only ./drizzle/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --dir ../../shared/common build && pnpm build && node --conditions=production --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@soc/contracts": "workspace:*",
    "@soc/shared": "workspace:*",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "drizzle-orm": "0.45.2",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.16.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "0.31.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
