FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY shared/api-client/package.json shared/api-client/package.json
COPY shared/contracts/package.json shared/contracts/package.json
COPY shared/common/package.json shared/common/package.json
COPY shared/config/package.json shared/config/package.json
COPY shared/config/tsconfig/base.json shared/config/tsconfig/base.json

RUN pnpm install --filter @soc/web... --frozen-lockfile

COPY apps/web apps/web
COPY shared/api-client shared/api-client
COPY shared/contracts shared/contracts
COPY shared/common shared/common
COPY shared/config shared/config

RUN pnpm --filter @soc/shared build
RUN pnpm --filter @soc/contracts build
RUN pnpm --filter @soc/api-client build
RUN pnpm --filter @soc/web build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runtime

RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx /tmp/nginx \
  && chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /tmp/nginx /usr/share/nginx/html \
  && sed -i 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf

COPY --chown=nginx:nginx apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /app/apps/web/dist /usr/share/nginx/html

USER nginx

EXPOSE 5173
