{
  "name": "soc-web-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @soc/api --filter @soc/web dev",
    "dev:api": "pnpm --filter @soc/api dev",
    "dev:web": "pnpm --filter @soc/web dev",
    "db:migrate": "bash infra/scripts/db-migrate.sh",
    "db:seed": "bash infra/scripts/db-seed.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api:unit": "pnpm --filter @soc/api test:unit",
    "test:api:int": "pnpm --filter @soc/api test:int",
    "test:api:http": "pnpm --filter @soc/api test:http",
    "test:migrations": "node --test infra/scripts/verify-migrations.test.mjs && bash infra/scripts/test-migrations.sh",
    "test:web:unit": "pnpm --filter @soc/web test:unit",
    "test:web:e2e": "pnpm --filter @soc/web test:e2e"
  }
}
