{
  "name": "soc-web-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "build:shared": "pnpm --filter @soc/contracts build && pnpm --filter @soc/shared build && pnpm --filter @soc/api-client build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter @soc/api --filter @soc/web dev",
    "dev:api": "pnpm build:shared && pnpm --filter @soc/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @soc/web dev",
    "db:migrate": "docker compose -p soc_web exec -T api pnpm db:migrate",
    "db:seed": "docker compose -p soc_web exec -T api pnpm db:seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@nestjs/core"]
  }
}
