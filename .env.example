NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
API_BASE_URL=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:5173

# Generate a P-256 key pair for development. Keep the private key out of git.
AUTH_JWT_ACTIVE_KID=dev-2026-01
AUTH_JWT_ES256_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-pkcs8-p256-private-key\n-----END PRIVATE KEY-----"
AUTH_JWT_PUBLIC_KEYS_JSON={"dev-2026-01":"-----BEGIN PUBLIC KEY-----\nreplace-with-spki-p256-public-key\n-----END PUBLIC KEY-----\n"}
AUTH_JWT_ISSUER=soc-web-dev
AUTH_JWT_AUDIENCE=soc-api
AUTH_PENDING_LOGIN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Required only for the one-time authorization bootstrap; must match one verified SSO subject.
AUTHORIZATION_BOOTSTRAP_SSO_SUBJECT=replace-with-verified-sso-subject
# Keep false after the one-time operator-only bootstrap/backfill window closes.
AUTHORIZATION_OPERATIONS_ENABLED=false
# Leave disabled until an asset provider is configured.
ASSET_PROVIDER_ENABLED=false
# Number of days deleted content remains recoverable before purge.
CONTENT_PURGE_GRACE_DAYS=30
# Number of days deleted contacts remain recoverable before purge.
CONTACT_PURGE_GRACE_DAYS=30
# Provider-backed operations remain fail-closed until approved integrations exist.
MAIL_PROVIDER_ENABLED=false
CHAT_PROVIDER_ENABLED=false
# Generate a 32-byte key with: openssl rand -base64 32
PII_ENCRYPTION_ACTIVE_KID=dev-pii-2026-01
PII_ENCRYPTION_KEYS_JSON={"dev-pii-2026-01":"replace-with-base64-encoded-32-byte-key"}
# Generate exactly 32 bytes with: openssl rand -base64 32
SURVEY_PHONE_HASH_HMAC_KEY=replace-with-base64-encoded-32-byte-key
SURVEY_PHONE_HASH_HMAC_VERSION=dev-survey-phone-v1
SURVEY_PHONE_HASH_HMAC_PRIOR_KEYS_JSON={}

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_web
POSTGRES_USER=soc
POSTGRES_PASSWORD=soc
DATABASE_URL=postgresql://soc:soc@localhost:5432/soc_web?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Optional. If omitted, the frontend derives /start from VITE_SSO_REDIRECT_URI.
VITE_SSO_START_URL=https://soc-student-council.kws.inet.sparcs.net/api/auth/login/start
VITE_SSO_REDIRECT_URI=https://soc-student-council.kws.inet.sparcs.net/api/auth/login

VITE_SSO_LOGIN_URL=https://sso.kaist.ac.kr/auth/user/single/login/authorize
VITE_SSO_CLIENT_ID=single-auth-test
SSO_AUTH_API_URL=https://sso.kaist.ac.kr/auth/api/single/auth
SSO_CLIENT_SECRET=replace-with-issued-client-secret
