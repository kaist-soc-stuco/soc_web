NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
NGINX_PORT=8080
VITE_API_BASE_URL=/api
CORS_ORIGIN=http://localhost:8080

AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_PENDING_LOGIN_ENCRYPTION_KEY=replace-with-a-long-random-secret
# 운영에서는 인증 암호화 키와 분리된 32바이트 이상의 비밀값을 사용하세요.
VOTE_BALLOT_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# 쉼표로 여러 학과를 허용할 수 있음. 학과 정보가 없거나 목록 밖이면 로그인/권한 만료 처리.
AUTH_ELIGIBLE_DEPARTMENTS=전산학부
REDIS_AUTH_TTL_SECONDS=300

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_web
POSTGRES_USER=soc
POSTGRES_PASSWORD=replace-with-database-password
REDIS_URL=redis://localhost:6379

SSO_LOGIN_URL=https://sso.kaist.ac.kr/auth/user/single/login/authorize
SSO_REDIRECT_URI=http://localhost:8080/api/auth/login
SSO_CLIENT_ID=replace-with-issued-client-id
SSO_AUTH_API_URL=https://sso.kaist.ac.kr/auth/api/single/auth
SSO_CLIENT_SECRET=replace-with-issued-client-secret

# 운영 메일 발송은 Dooray SMTP만 사용합니다.
DOORAY_SMTP_HOST=
DOORAY_SMTP_PORT=587
DOORAY_SMTP_USER=
DOORAY_SMTP_PASSWORD=
DOORAY_SMTP_SECURE=false
EMAIL_FROM=
EMAIL_DRY_RUN=true
BULK_EMAIL_SCHEDULER_ENABLED=true
BULK_EMAIL_SCHEDULER_INTERVAL_MS=30000
BULK_EMAIL_MAX_ATTACHMENT_BYTES=26214400

CHANNELTALK_PLUGIN_KEY=
CHANNELTALK_SECRET_KEY=

KOREAN_HOLIDAY_API_KEY=
CALENDAR_EXTERNAL_ICS_URLS=

# Google Calendar publication. Keep the local service-account JSON at
# secrets/google-calendar-service-account.json; it is gitignored.
GOOGLE_CALENDAR_ID=
GOOGLE_KAIST_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-calendar-service-account.json
GOOGLE_OAUTH_CLIENT_KEY_FILE=/run/secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=/run/secrets/google-oauth-token.json
GOOGLE_CONTACTS_SPREADSHEET_ID=
GOOGLE_SURVEY_RESULTS_FOLDER_NAME=KAIST SOC 설문 결과
# Optional: only set when the OAuth app can access an existing folder.
GOOGLE_SURVEY_RESULTS_FOLDER_ID=
GOOGLE_CALENDAR_SYNC_ENABLED=false
KAIST_CALENDAR_SYNC_ENABLED=false

SEED_MODE=demo

ASSET_ORPHAN_GRACE_HOURS=24
ASSET_ORPHAN_CLEANUP_ENABLED=false
ASSET_ORPHAN_CLEANUP_INTERVAL_HOURS=6

# Asset storage: local for development, s3 for production.
ASSET_STORAGE_PROVIDER=local
ASSET_UPLOAD_DIR=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_PREFIX=soc/assets
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Prefer workload IAM role in production. Set these only for local/CI credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
