NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
NGINX_PORT=8080
VITE_API_BASE_URL=/api

AUTH_JWT_SECRET=dev-auth-jwt-secret-change-me
AUTH_PENDING_LOGIN_ENCRYPTION_KEY=replace-with-32-plus-char-random-secret
REDIS_AUTH_TTL_SECONDS=300

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_web
POSTGRES_USER=soc
POSTGRES_PASSWORD=soc

REDIS_URL=redis://localhost:6379

SSO_LOGIN_URL=https://sso.kaist.ac.kr/auth/user/single/login/authorize
SSO_REDIRECT_URI=https://soc-student-council.example.com/api/auth/login
SSO_CLIENT_ID=single-auth-test
SSO_AUTH_API_URL=https://sso.kaist.ac.kr/auth/api/single/auth
SSO_CLIENT_SECRET=replace-with-issued-client-secret

# Channel Talk: plugin key may be exposed to the browser; keep the secret key backend-only.
CHANNELTALK_PLUGIN_KEY=
CHANNELTALK_SECRET_KEY=

# Email: development defaults to dry-run. Configure SMTP before real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_DRY_RUN=true

# Issue a new key before enabling Korean public-holiday lookup.
KOREAN_HOLIDAY_API_KEY=

# reference: permissions/boards only, demo: destructive local sample content
SEED_MODE=demo

# Optional local override for uploaded file storage.
# ASSET_UPLOAD_DIR=/absolute/path/to/uploads/assets
ASSET_ORPHAN_GRACE_HOURS=24
ASSET_ORPHAN_CLEANUP_ENABLED=false
ASSET_ORPHAN_CLEANUP_INTERVAL_HOURS=6
