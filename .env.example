# Local development defaults. Create a working .env with:
#   node infra/scripts/generate-dev-env.mjs
# For an existing placeholder-filled .env, run the generator with --repair.
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
NGINX_PORT=8080
POSTGRES_HOST_PORT=5432

# Docker Compose uses nginx at this origin. Change to http://localhost:5173 for host-run Vite.
PUBLIC_ORIGIN=http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:3000

# JWT and encrypted-PII keys are generated by generate-dev-env.mjs; never commit .env.
AUTH_JWT_ACTIVE_KID=local-dev-2026
AUTH_JWT_ES256_PRIVATE_KEY="REPLACE_WITH_GENERATED_PKCS8_P256_PRIVATE_KEY"
AUTH_JWT_PUBLIC_KEYS_JSON={"local-dev-2026":"REPLACE_WITH_GENERATED_SPKI_P256_PUBLIC_KEY"}
AUTH_JWT_ISSUER=soc-web-local-development
AUTH_JWT_AUDIENCE=soc-api
AUTH_PENDING_LOGIN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY

PII_ENCRYPTION_ACTIVE_KID=local-dev-pii-2026
PII_ENCRYPTION_KEYS_JSON={"local-dev-pii-2026":"REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY"}
SURVEY_PHONE_HASH_HMAC_KEY=REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY
SURVEY_PHONE_HASH_HMAC_VERSION=local-dev-survey-phone-v1
SURVEY_PHONE_HASH_HMAC_PRIOR_KEYS_JSON={}
# Inventory-derived complete-definition limits; production values require release/security approval.
SURVEY_DEFINITION_MAX_BYTES=262144
SURVEY_DEFINITION_PARSER_MAX_BYTES=266240
SURVEY_DEFINITION_HARD_MAX_BYTES=1048576
# Production only: set B/P/H and all report approval values from the read-only inventory report; unset values keep definition replacement fail-closed.
# SURVEY_DEFINITION_INVENTORY_REPORT_SHA256=<reportSha256 from canonical report>
# SURVEY_DEFINITION_INVENTORY_REPORT_JSON=<single-line canonical report payload, excluding reportSha256>
# SURVEY_DEFINITION_INVENTORY_SCHEMA=survey-definition-inventory-v2
# SURVEY_DEFINITION_INVENTORY_SERIALIZER=survey-definition-canonical-v2
# SURVEY_DEFINITION_INVENTORY_APPROVER=<release-or-security-approver-identity>
# SURVEY_DEFINITION_EXPECTED_DATABASE_IDENTITY=<current_database() of deployed database>
# SURVEY_DEFINITION_EXPECTED_MIGRATION_IDENTITY=<64-character deployed drizzle migration hash>

# Local data services. Containers override host names to postgres and redis.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_web
POSTGRES_USER=soc
POSTGRES_PASSWORD=soc
DATABASE_URL=postgresql://soc:soc@localhost:5432/soc_web?sslmode=disable
REDIS_HOST=localhost
REDIS_PORT=6379

# Development login works without SSO. Replace these only when testing the real SSO flow.
VITE_SSO_REDIRECT_URI=http://localhost:3000/api/auth/login
VITE_SSO_LOGIN_URL=https://sso.kaist.ac.kr/auth/user/single/login/authorize
VITE_SSO_CLIENT_ID=local-development
SSO_AUTH_API_URL=https://sso.kaist.ac.kr/auth/api/single/auth
SSO_CLIENT_SECRET=REPLACE_WITH_GENERATED_LOCAL_SECRET

# Keep provider-backed and operator-only functions disabled locally by default.
AUTHORIZATION_BOOTSTRAP_SSO_SUBJECT=
AUTHORIZATION_OPERATIONS_ENABLED=false
ASSET_PROVIDER_ENABLED=false
ASSET_PROVIDER_URL=
ASSET_PROVIDER_TOKEN=
MAIL_PROVIDER_ENABLED=false
CHAT_PROVIDER_ENABLED=false
MAIL_PROVIDER_URL=
MAIL_PROVIDER_TOKEN=
MAIL_FROM=
CHAT_PROVIDER_URL=
CHAT_PROVIDER_TOKEN=
CHAT_PROVIDER_MODEL=
CONTENT_PURGE_GRACE_DAYS=30
CONTACT_PURGE_GRACE_DAYS=30
# Production survey-response retention scheduler. It is disabled unless explicitly enabled.
# Set both alert values to real on-call routing identifiers before enabling; do not place secrets here.
SURVEY_RESPONSE_PURGE_ENABLED=false
SURVEY_RESPONSE_PURGE_CADENCE_SECONDS=900
# API structured stdout security events are collected by Docker's json-file driver.
# Retention is bounded by max-size × max-file; access is limited to production host operators.
API_LOG_MAX_SIZE=20m
API_LOG_MAX_FILES=10
SURVEY_RESPONSE_PURGE_BATCH_SIZE=100
SURVEY_RESPONSE_PURGE_ALERT_OWNER=
SURVEY_RESPONSE_PURGE_ALERT_SINK=
