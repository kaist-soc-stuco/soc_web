# Isolated browser security E2E configuration. Replace __HOST_IP__ at runtime.
# Every value in this file is synthetic; do not point it at production systems.
NODE_ENV=development
SEED_MODE=demo
API_PORT=3000
WEB_PORT=5173
NGINX_PORT=80
CORS_ORIGIN=http://__HOST_IP__:28765

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=soc_web_security_e2e
POSTGRES_USER=soc_security_e2e
POSTGRES_PASSWORD=soc_security_e2e
REDIS_URL=redis://redis:6379

AUTH_JWT_SECRET=security-e2e-jwt-secret-only
AUTH_PENDING_LOGIN_ENCRYPTION_KEY=security-e2e-pending-key-32-bytes
VOTE_BALLOT_ENCRYPTION_KEY=security-e2e-vote-key-32-bytes
INITIAL__ADMIN_STDNOS=90990001
REDIS_AUTH_TTL_SECONDS=300

SSO_LOGIN_URL=http://__HOST_IP__:28765/__local-sso/authorize
SSO_REDIRECT_URI=/api/auth/login
SSO_CLIENT_ID=soc-security-e2e
SSO_AUTH_API_URL=http://__HOST_IP__:28765/__local-sso/token
SSO_CLIENT_SECRET=security-e2e-client-secret
LOCAL_QA_BIND=__HOST_IP__
LOCAL_QA_PORT=28765
LOCAL_QA_UPSTREAM=http://127.0.0.1:28080

EMAIL_DRY_RUN=true
BULK_EMAIL_SCHEDULER_ENABLED=false
EMAIL_FROM=security-e2e@example.invalid
DOORAY_SMTP_PORT=587

GOOGLE_CALENDAR_SYNC_ENABLED=false
KAIST_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_KAIST_CALENDAR_ID=
GOOGLE_OPERATIONS_FOLDER_ID=
GOOGLE_CONTACTS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_OAUTH_CLIENT_KEY_FILE=
GOOGLE_OAUTH_TOKEN_FILE=

ASSET_STORAGE_PROVIDER=local
ASSET_UPLOAD_DIR=/app/apps/api/uploads/assets
ASSET_ORPHAN_CLEANUP_ENABLED=false
ASSET_USER_MAX_COUNT=100
ASSET_USER_MAX_BYTES=536870912
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
